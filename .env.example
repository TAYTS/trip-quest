# Leave these empty to play in "local mode" (journal saved in this browser only).
# Fill them in (locally in .env.local, and in Vercel → Project → Settings → Environment Variables)
# to sync the journal between devices through Supabase.
# (On Vercel with the Supabase integration, its NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# are picked up automatically, so you do not need to add these two there.)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local testing only: set to true in .env.local to unlock every checkpoint
# (ignores both the order lock and the date lock, and allows undo on any checkpoint).
# Never set this in Vercel.
VITE_UNLOCK_ALL=false

# Set to true to show Settings → "Test mode: ignore dates" (try the game before the trip).
# Leave it unset in the build you use on the trip.
VITE_ENABLE_TEST_MODE=false

# Set to true to make the cloud trip mandatory: the game shows "Create a trip / Join with a code" first
# and never saves to the browser only. Needs the two Supabase values above.
VITE_REQUIRE_TRIP=false

# Shows the "Panda Wishes" box (Gemini food / place tips) in each checkpoint. Needs a synced trip AND the
# ask-guide Edge Function deployed (see README). The Gemini key is NOT set here; it lives in Supabase secrets.
VITE_ENABLE_GUIDE=false

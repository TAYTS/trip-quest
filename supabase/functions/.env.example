# For running the function locally (`supabase functions serve ask-guide --env-file supabase/functions/.env`).
# Copy this file to supabase/functions/.env (it is gitignored). In production, set secrets with
# `supabase secrets set GEMINI_API_KEY=...` instead; this file is never uploaded.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GUIDE_DAILY_LIMIT=30
# GUIDE_GROUNDING=agent   # agent (default) | search | none
#   agent  = Antigravity agent + Google Search (free tier: 100 requests/day), slower, can take up to a minute
#   search = Google Search on GEMINI_MODEL (paid Gemini plan only)
#   none   = answers from the model's memory only
# GUIDE_AGENT_MODEL=gemini-3.5-flash-lite   # model the agent runs on
